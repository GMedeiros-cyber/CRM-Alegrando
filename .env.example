# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# n8n
# N8N_ZAPI_WEBHOOK_URL: webhook do n8n que recebe eventos da Z-API (Jade/Alegrando)
N8N_ZAPI_WEBHOOK_URL=
# N8N_EVOLUTION_WEBHOOK_URL: webhook do n8n que recebe eventos da Evolution (Márcia/Festas)
# Ex: https://n8n.alegrando.cloud/webhook/evolution-marcia
N8N_EVOLUTION_WEBHOOK_URL=
# N8N_EMAIL_WEBHOOK_URL: webhook do workflow "Envio de E-mail - Alegrando"
# Ex: https://n8n.alegrando.cloud/webhook/email-send
N8N_EMAIL_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# Google (Calendar + Drive)
# Um único OAuth Client atende os dois, mas cada um tem seu PRÓPRIO refresh
# token: revogar ou reemitir um não derruba o outro.
# Gere cada token com:
#   npx tsx scripts/google-drive-consent.ts calendar  → GOOGLE_REFRESH_TOKEN
#   npx tsx scripts/google-drive-consent.ts drive     → GOOGLE_DRIVE_REFRESH_TOKEN
# O client precisa ter http://localhost:53682/callback nos redirects autorizados.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Escopo calendar (read/write): a agenda cria, edita e exclui eventos.
GOOGLE_REFRESH_TOKEN=
# Escopo drive.readonly: só listar e baixar arquivos pra anexar no e-mail.
# Sem ele, o seletor do Drive fica indisponível — o resto do e-mail funciona.
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# API key do Google Picker (a janela nativa de escolher arquivo do Drive).
# Vai pro browser por natureza — o que a protege é a restrição por HTTP
# referrer no Console (https://crm.alegrando.cloud/* e http://localhost:3000/*)
# e a limitação à Google Picker API. Sem ela o seletor não abre.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# Z-Api
# ZAPI_CLIENT_TOKEN: usado tanto pelo sender quanto para validar o header
# `Client-Token` enviado pela Z-API nos webhooks (verifyZapiWebhook).
# Configure o mesmo valor no painel Z-API > Segurança > Token de Webhook.
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Evolution API (Festas - Márcia)
# EVOLUTION_API_KEY: usado tanto para chamadas outbound (sender) quanto para
# validar o header `apikey` enviado pela Evolution nos webhooks (verifyEvolutionWebhook).
EVOLUTION_API_URL=https://evo.alegrando.cloud
EVOLUTION_INSTANCE=Festas
EVOLUTION_API_KEY=

# OpenAI (Gerar Markdown de passeios + embeddings RAG)
OPENAI_API_KEY=

# Cloudflare R2 (uploads de mídia NÃO-áudio do WhatsApp: imagem/vídeo/documento/sticker)
# Áudio (bucket `audios`) e avatares continuam no Supabase Storage — R2 é só o ramo
# que antes ia pro bucket `documents`. Valores em Cloudflare Dashboard → R2.
# R2_SECRET_ACCESS_KEY é SECRETO: cole no .env.local e na Vercel (Production), NUNCA commitar.
# (Ignore o "Token value" cfat_... da Cloudflare — não é usado; o client S3 usa só as keys abaixo.)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=alegrando-media
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Emergência: desativa validação de Client-Token/apikey nos webhooks Z-API e Evolution.
# Use SOMENTE em incidente quando os tokens estiverem dessincronizados — NÃO usar permanentemente.
# WEBHOOK_AUTH_DISABLE=true

# CRM
ALLOWED_EMAILS=
GOOGLE_REVIEW_LINK=
CRON_SECRET=
